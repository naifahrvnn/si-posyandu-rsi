# Koneksi SQL Server (SQL Server Authentication)
DB_SERVER=localhost
DB_PORT=1433
# Isi bila memakai instance bernama, mis. SQLEXPRESS (kosongkan DB_PORT, nyalakan SQL Server Browser)
DB_INSTANCE=
DB_NAME=
DB_USER=
# Beri tanda kutip; tanpa kutip, karakter # dan sesudahnya dianggap komentar
DB_PASSWORD=""
# SQL Server lokal memakai sertifikat self-signed -> trust = true
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# Server
PORT=3000
# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# Opsional (boleh dikosongkan, nilai bawaan dipakai)
# Jumlah koneksi maksimal ke SQL Server
DB_POOL_MAKS=10
# Batas waktu satu query (milidetik); lebih lama -> 503 ERR-SYS-01
DB_QUERY_TIMEOUT_MS=15000
